digraph ER {
  graph [rankdir=TB, splines=true, nodesep=0.45, ranksep=1.3, fontname="Liberation Sans", pad=0.3];
  node [shape=plaintext, fontname="Liberation Sans", fontsize=11];
  edge [fontname="Liberation Sans", fontsize=9, fontcolor="#1f3a5a", color="#555555", arrowsize=0.8, dir=both];
  acc [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f4f6f"><font color="white"><b>Учётная запись</b></font></td></tr><tr><td align="left"><font point-size="9">логин</font></td></tr><tr><td align="left"><font point-size="9">хеш пароля</font></td></tr><tr><td align="left"><font point-size="9">роль</font></td></tr><tr><td align="left"><font point-size="9">признак блокировки</font></td></tr><tr><td align="left"><font point-size="9">дата создания</font></td></tr></table>>];
  apt [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f4f6f"><font color="white"><b>Квартира</b></font></td></tr><tr><td align="left"><font point-size="9">номер</font></td></tr><tr><td align="left"><font point-size="9">этаж</font></td></tr><tr><td align="left"><font point-size="9">площадь</font></td></tr><tr><td align="left"><font point-size="9">тариф квартплаты</font></td></tr></table>>];
  res [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f4f6f"><font color="white"><b>Жилец</b></font></td></tr><tr><td align="left"><font point-size="9">ФИО</font></td></tr><tr><td align="left"><font point-size="9">дата рождения</font></td></tr><tr><td align="left"><font point-size="9">телефон</font></td></tr><tr><td align="left"><font point-size="9">индекс лояльности</font></td></tr><tr><td align="left"><font point-size="9">коммунальный баланс</font></td></tr><tr><td align="left"><font point-size="9">статус проживания</font></td></tr><tr><td align="left"><font point-size="9">даты заселения и выселения</font></td></tr><tr><td align="left"><font point-size="9">основание выселения</font></td></tr></table>>];
  inv [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f4f6f"><font color="white"><b>Код приглашения</b></font></td></tr><tr><td align="left"><font point-size="9">код</font></td></tr><tr><td align="left"><font point-size="9">дата выдачи</font></td></tr><tr><td align="left"><font point-size="9">дата использования</font></td></tr></table>>];
  srv [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f4f6f"><font color="white"><b>Услуга</b></font></td></tr><tr><td align="left"><font point-size="9">код</font></td></tr><tr><td align="left"><font point-size="9">название</font></td></tr><tr><td align="left"><font point-size="9">описание</font></td></tr><tr><td align="left"><font point-size="9">минимальный ИЛ</font></td></tr><tr><td align="left"><font point-size="9">пошлина</font></td></tr><tr><td align="left"><font point-size="9">вид результата</font></td></tr><tr><td align="left"><font point-size="9">требуется период</font></td></tr></table>>];
  req [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f4f6f"><font color="white"><b>Заявка</b></font></td></tr><tr><td align="left"><font point-size="9">описание</font></td></tr><tr><td align="left"><font point-size="9">запрошенный период</font></td></tr><tr><td align="left"><font point-size="9">статус</font></td></tr><tr><td align="left"><font point-size="9">уплаченная пошлина</font></td></tr><tr><td align="left"><font point-size="9">признак возврата пошлины</font></td></tr><tr><td align="left"><font point-size="9">заключение</font></td></tr><tr><td align="left"><font point-size="9">текст документа</font></td></tr><tr><td align="left"><font point-size="9">срок действия</font></td></tr><tr><td align="left"><font point-size="9">причина отказа</font></td></tr><tr><td align="left"><font point-size="9">даты подачи и изменения</font></td></tr></table>>];
  ev [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f4f6f"><font color="white"><b>Событие заявки</b></font></td></tr><tr><td align="left"><font point-size="9">исходный статус</font></td></tr><tr><td align="left"><font point-size="9">новый статус</font></td></tr><tr><td align="left"><font point-size="9">комментарий</font></td></tr><tr><td align="left"><font point-size="9">дата</font></td></tr></table>>];
  den [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f4f6f"><font color="white"><b>Донос</b></font></td></tr><tr><td align="left"><font point-size="9">описание</font></td></tr><tr><td align="left"><font point-size="9">дата события</font></td></tr><tr><td align="left"><font point-size="9">анонимность</font></td></tr><tr><td align="left"><font point-size="9">статус</font></td></tr><tr><td align="left"><font point-size="9">комментарий решения</font></td></tr><tr><td align="left"><font point-size="9">даты подачи и рассмотрения</font></td></tr></table>>];
  pun [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f4f6f"><font color="white"><b>Наказание</b></font></td></tr><tr><td align="left"><font point-size="9">вид</font></td></tr><tr><td align="left"><font point-size="9">сумма штрафа</font></td></tr><tr><td align="left"><font point-size="9">основание</font></td></tr><tr><td align="left"><font point-size="9">дата</font></td></tr><tr><td align="left"><font point-size="9">признак снятия</font></td></tr></table>>];
  pay [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f4f6f"><font color="white"><b>Платёж</b></font></td></tr><tr><td align="left"><font point-size="9">идентификатор ЮKassa</font></td></tr><tr><td align="left"><font point-size="9">сумма</font></td></tr><tr><td align="left"><font point-size="9">статус</font></td></tr><tr><td align="left"><font point-size="9">даты создания и подтверждения</font></td></tr></table>>];
  rent [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f4f6f"><font color="white"><b>Начисление квартплаты</b></font></td></tr><tr><td align="left"><font point-size="9">период</font></td></tr><tr><td align="left"><font point-size="9">сумма</font></td></tr><tr><td align="left"><font point-size="9">срок оплаты</font></td></tr><tr><td align="left"><font point-size="9">статус</font></td></tr><tr><td align="left"><font point-size="9">дата оплаты</font></td></tr><tr><td align="left"><font point-size="9">признак просрочки</font></td></tr></table>>];
  op [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f4f6f"><font color="white"><b>Операция по балансу</b></font></td></tr><tr><td align="left"><font point-size="9">тип</font></td></tr><tr><td align="left"><font point-size="9">сумма</font></td></tr><tr><td align="left"><font point-size="9">баланс после операции</font></td></tr><tr><td align="left"><font point-size="9">дата</font></td></tr></table>>];
  rule [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f4f6f"><font color="white"><b>Правило ИЛ</b></font></td></tr><tr><td align="left"><font point-size="9">код</font></td></tr><tr><td align="left"><font point-size="9">описание</font></td></tr><tr><td align="left"><font point-size="9">изменение ИЛ</font></td></tr></table>>];
  lc [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f4f6f"><font color="white"><b>Изменение ИЛ</b></font></td></tr><tr><td align="left"><font point-size="9">применённое изменение</font></td></tr><tr><td align="left"><font point-size="9">значение после</font></td></tr><tr><td align="left"><font point-size="9">комментарий</font></td></tr><tr><td align="left"><font point-size="9">дата</font></td></tr></table>>];
  note [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f4f6f"><font color="white"><b>Заметка досье</b></font></td></tr><tr><td align="left"><font point-size="9">текст</font></td></tr><tr><td align="left"><font point-size="9">дата</font></td></tr></table>>];
  ntf [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#2f4f6f"><font color="white"><b>Уведомление</b></font></td></tr><tr><td align="left"><font point-size="9">текст</font></td></tr><tr><td align="left"><font point-size="9">признак прочтения</font></td></tr><tr><td align="left"><font point-size="9">дата</font></td></tr></table>>];
  acc -> res [arrowtail=teeodot, arrowhead=teeodot, label="владеет"];
  apt -> res [arrowtail=teetee, arrowhead=crowodot, label="проживает"];
  res -> inv [arrowtail=teetee, arrowhead=teetee, label="получает"];
  res -> req [arrowtail=teetee, arrowhead=crowodot, label="подаёт"];
  srv -> req [arrowtail=teetee, arrowhead=crowodot, label="запрашивается"];
  apt -> req [arrowtail=teeodot, arrowhead=crowodot, label="переселение в"];
  req -> ev [arrowtail=teetee, arrowhead=crowtee, label="имеет историю"];
  acc -> ev [arrowtail=teeodot, arrowhead=crowodot, label="выполняет"];
  res -> den [arrowtail=teetee, arrowhead=crowodot, label="автор"];
  res -> den [arrowtail=teetee, arrowhead=crowodot, label="подозреваемый"];
  acc -> den [arrowtail=teeodot, arrowhead=crowodot, label="рассматривает"];
  res -> pun [arrowtail=teetee, arrowhead=crowodot, label="получает"];
  acc -> pun [arrowtail=teetee, arrowhead=crowodot, label="назначает"];
  den -> pun [arrowtail=crowodot, arrowhead=crowodot, label="является основанием  (M:N)", color="#b03030", penwidth=1.6, fontcolor="#b03030"];
  req -> pun [arrowtail=teeodot, arrowhead=teeodot, label="снимает"];
  res -> pay [arrowtail=teetee, arrowhead=crowodot, label="вносит"];
  res -> rent [arrowtail=teetee, arrowhead=crowodot, label="оплачивает"];
  apt -> rent [arrowtail=teetee, arrowhead=crowodot, label="начисляется за"];
  res -> op [arrowtail=teetee, arrowhead=crowodot, label="изменяет баланс"];
  pay -> op [arrowtail=teeodot, arrowhead=teeodot, label="источник"];
  rent -> op [arrowtail=teeodot, arrowhead=teeodot, label="источник"];
  req -> op [arrowtail=teeodot, arrowhead=crowodot, label="источник"];
  pun -> op [arrowtail=teeodot, arrowhead=teeodot, label="источник"];
  res -> lc [arrowtail=teetee, arrowhead=crowodot, label="изменяет ИЛ"];
  rule -> lc [arrowtail=teetee, arrowhead=crowodot, label="применяется"];
  den -> lc [arrowtail=teeodot, arrowhead=crowodot, label="причина"];
  pun -> lc [arrowtail=teeodot, arrowhead=crowodot, label="причина"];
  rent -> lc [arrowtail=teeodot, arrowhead=crowodot, label="причина"];
  req -> lc [arrowtail=teeodot, arrowhead=crowodot, label="причина"];
  res -> note [arrowtail=teetee, arrowhead=crowodot, label="описывается"];
  acc -> note [arrowtail=teetee, arrowhead=crowodot, label="составляет"];
  acc -> ntf [arrowtail=teetee, arrowhead=crowodot, label="получает"];
}